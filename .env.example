OPENAI_API_KEY=

# Source site
SGE_BASE_URL=https://www.socialgrowthengineers.com

# Fetching: auto, http, or browser.
# Use browser after running: sge-rag login
SGE_FETCHER=auto
SGE_BROWSER_STATE_PATH=data/browser_state.json
SGE_BROWSER_HEADLESS=true

# Storage
SGE_DATA_DIR=data
SGE_CHROMA_DIR=data/chroma
SGE_COLLECTION_NAME=sge_articles
SGE_VECTORSTORE=chroma
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Models
SGE_EMBEDDING_PROVIDER=openai
SGE_EMBEDDING_MODEL=text-embedding-3-small
SGE_ANSWER_MODEL=gpt-5.4-mini
SGE_FAST_MODEL=gpt-5.4-mini
SGE_DEEP_MODEL=gpt-5.5

# Chunking
SGE_CHUNK_TARGET_TOKENS=850
SGE_CHUNK_OVERLAP_TOKENS=120

# Local Next.js retrieval fallback when SGE_VECTORSTORE=chroma.
SGE_RAG_API_URL=http://127.0.0.1:8000
